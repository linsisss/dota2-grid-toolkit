# Node release scripts only. Never prefix secrets with VITE_.
# Copy to .env.release.local (ignored by git).
TELEGRAM_BOT_TOKEN=

# Catalog backend only; copy to .env.catalog.local. Never prefix secrets with VITE_.
CATALOG_ORIGIN=https://gridstudio.me
CATALOG_SECRET=
# Telegram IDs allowed into the site admin panel (/workshop?moderate), comma-separated. Empty = nobody.
CATALOG_ADMIN_TELEGRAM_IDS=
CATALOG_TELEGRAM_CHAT_ID=-1004309207941
CATALOG_TELEGRAM_TOPIC_ID=6
CATALOG_TELEGRAM_BOT_USERNAME=grid_studio_bot
# Optional dedicated token; otherwise catalog:bot uses TELEGRAM_BOT_TOKEN.
CATALOG_TELEGRAM_BOT_TOKEN=
# Optional, backend only. Without a key, vanity links use Steam Community XML.
STEAM_WEB_API_KEY=
# Enable only behind a trusted loopback reverse proxy which overwrites X-Forwarded-For.
CATALOG_TRUST_PROXY=loopback
# Local development uses CATALOG_DEV=1 and an http://127.0.0.1 origin.
